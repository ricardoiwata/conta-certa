POST http://localhost:3000/receita
Content-Type: application/json

{
    "valor": 800.00,
    "data": "01/02/2026",
    "dataCompetencia": "01/02/2026",
    "descricao": "Freelance desenvolvimento",
    "origem": "Variável",
    "recorrentePai": false,
    "recorrentePaiId": 0,
